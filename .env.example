# Copiez ce fichier en .env pour le développement local.
# En production, ajoutez ces 3 valeurs comme SECRETS dans Cloudflare :
# Workers & Pages > masociete > Settings > Variables and Secrets.
ADMIN_EMAIL=contact@masociete.ma
# 10 caractères minimum
ADMIN_PASSWORD=
# 32 caractères minimum (ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
