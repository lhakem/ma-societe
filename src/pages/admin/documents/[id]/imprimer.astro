---
export const prerender = false;
import DocumentSheet from '../../../../components/DocumentSheet.astro';
import { getDocument, getSettings } from '../../../../lib/db';

const id = Number(Astro.params.id);
const full = Number.isInteger(id) ? await getDocument(id) : undefined;
if (!full) return Astro.redirect('/admin/documents/');
const s = await getSettings();
---

<DocumentSheet doc={full.doc} client={full.client} lines={full.lines} s={s} backHref={`/admin/documents/${full.doc.id}/`} />
