---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { dashboard } from '../../lib/db';
import { madShort, mad, fmtDate, fmtDateTime, today } from '../../lib/money';
import { stepsFor } from '../../config/admin';

const { stats: s, inProgress, leads, unpaid, activity } = await dashboard();
const now = today();
---

<AdminLayout title="Tableau de bord" active="dashboard">
  <Fragment slot="actions">
    <a class="btn btn--ghost btn--sm" href="/admin/clients/nouveau/"><Icon name="plus" />Nouveau client</a>
    <a class="btn btn--primary btn--sm" href="/admin/documents/nouveau/?type=devis"><Icon name="plus" />Nouveau devis</a>
  </Fragment>

  <div class="a-kpis">
    <a class="a-kpi" href="/admin/clients/?status=nouveau">
      <p class="k-label">Nouveaux contacts</p>
      <p class="k-value">{s.nouveaux}</p>
      <p class="k-sub">à rappeler</p>
    </a>
    <a class="a-kpi" href="/admin/clients/?status=en_cours">
      <p class="k-label">Dossiers en cours</p>
      <p class="k-value">{s.enCours}</p>
      <p class="k-sub">en traitement</p>
    </a>
    <a class="a-kpi" href="/admin/documents/?type=devis&status=envoye">
      <p class="k-label">Devis en attente</p>
      <p class="k-value">{madShort(s.devisAttente.s)}</p>
      <p class="k-sub">{s.devisAttente.n} devis envoyé(s)</p>
    </a>
    <div class="a-kpi">
      <p class="k-label">Facturé ce mois</p>
      <p class="k-value">{madShort(s.factureMois)}</p>
      <p class="k-sub">encaissé : {madShort(s.encaisseMois)}</p>
    </div>
    <a class:list={['a-kpi', { warn: s.enRetard > 0 }]} href="/admin/documents/?type=facture&status=emise">
      <p class="k-label">Reste à encaisser</p>
      <p class="k-value">{madShort(s.impayes.s)}</p>
      <p class="k-sub">{s.impayes.n} facture(s){s.enRetard > 0 && ` · ${s.enRetard} en retard`}</p>
    </a>
  </div>

  <div class="a-split">
    <div>
      <section class="a-card">
        <h2>Dossiers en cours <a href="/admin/clients/?status=en_cours">Tout voir</a></h2>
        {
          inProgress.length === 0 ? (
            <p class="a-empty">Aucun dossier en cours.</p>
          ) : (
            <div class="a-table-wrap">
              <table class="a-table">
                <thead>
                  <tr><th>Client</th><th>Prestation</th><th>Étape actuelle</th><th>Avancement</th></tr>
                </thead>
                <tbody>
                  {inProgress.map((c) => {
                    const steps = stepsFor(c.service);
                    const pct = Math.round((Math.min(c.step, steps.length) / steps.length) * 100);
                    return (
                      <tr>
                        <td><a class="row-link" href={`/admin/clients/${c.id}/`}>{c.name}</a>{c.company && <small>{c.company}</small>}</td>
                        <td>{c.service ?? '—'}</td>
                        <td>{steps[Math.min(c.step, steps.length - 1)]}</td>
                        <td><div class="a-progress" title={`${pct} %`}><span style={`width:${pct}%`} /></div></td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )
        }
      </section>

      <section class="a-card">
        <h2>Factures à encaisser <a href="/admin/documents/?type=facture">Toutes les factures</a></h2>
        {
          unpaid.length === 0 ? (
            <p class="a-empty">Aucune facture en attente de paiement.</p>
          ) : (
            <div class="a-table-wrap">
              <table class="a-table">
                <thead>
                  <tr><th>Facture</th><th>Client</th><th>Échéance</th><th class="num">Reste dû</th></tr>
                </thead>
                <tbody>
                  {unpaid.map((d) => (
                    <tr>
                      <td><a class="row-link" href={`/admin/documents/${d.id}/`}>{d.number}</a></td>
                      <td>{d.client_name}</td>
                      <td>
                        {fmtDate(d.due_date)}
                        {d.due_date && d.due_date < now && <span class="a-badge tone-danger">En retard</span>}
                      </td>
                      <td class="num">{mad(d.total_ttc - d.paid)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </section>
    </div>

    <div>
      <section class="a-card">
        <h2>Nouveaux contacts <a href="/admin/clients/?status=nouveau">Tout voir</a></h2>
        {
          leads.length === 0 ? (
            <p class="a-empty">Aucun nouveau contact. Les demandes du formulaire du site arrivent ici.</p>
          ) : (
            <ul class="lead-list">
              {leads.map((c) => (
                <li>
                  <a href={`/admin/clients/${c.id}/`}>
                    <strong>{c.name}</strong>
                    <small>{[c.service, c.city, c.source].filter(Boolean).join(' · ')}</small>
                  </a>
                  <time>{fmtDateTime(c.created_at)}</time>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <section class="a-card">
        <h2>Activité récente</h2>
        {
          activity.length === 0 ? (
            <p class="a-empty">Rien pour le moment.</p>
          ) : (
            <ul class="a-timeline">
              {activity.map((a) => (
                <li class={`k-${a.kind}`}>
                  <div>
                    <time>{fmtDateTime(a.created_at)} · <a href={`/admin/clients/${a.client_id}/`}>{a.client_name}</a></time>
                    <p>{a.text}</p>
                  </div>
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </div>
  </div>
</AdminLayout>

<style>
  .lead-list {
    list-style: none;
    padding: 0;
    display: grid;
  }
  .lead-list li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid #efe9df;
  }
  .lead-list li:last-child {
    border: 0;
  }
  .lead-list a {
    text-decoration: none;
    color: var(--ink-900);
  }
  .lead-list strong {
    display: block;
  }
  .lead-list small {
    color: var(--ink-500);
    font-size: 0.82rem;
  }
  .lead-list time {
    font-size: 0.78rem;
    color: var(--ink-400);
    white-space: nowrap;
  }
</style>
