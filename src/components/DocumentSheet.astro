---
/** Devis / facture au format A4 (aperçu écran + impression PDF). Utilisé par l'admin ET la page de suivi client. */
import '@fontsource-variable/bricolage-grotesque';
import type { Doc, Line, Client, Settings } from '../lib/db';
import { computeTotals, lineTotal } from '../lib/totals';
import { mad, fmtDate, amountInWords } from '../lib/money';

interface Props {
  doc: Doc;
  client: Client;
  lines: Line[];
  s: Settings;
  backHref: string;
  backLabel?: string;
}
const { doc, client, lines, s, backHref, backLabel = 'Retour' } = Astro.props;
const t = computeTotals(lines);
const isDevis = doc.type === 'devis';
const title = isDevis ? 'DEVIS' : 'FACTURE';
const legal = [
  s.company_name,
  s.address,
  s.if && `IF : ${s.if}`,
  s.ice && `ICE : ${s.ice}`,
  s.rc && `RC : ${s.rc}`,
  s.tp && `TP : ${s.tp}`,
  s.cnss && `CNSS : ${s.cnss}`,
].filter(Boolean);
const stamp =
  doc.status === 'payee' ? 'PAYÉE' : doc.status === 'annulee' ? 'ANNULÉE' : doc.type === 'facture' && !doc.number ? 'BROUILLON' : null;
const fileName = `${isDevis ? 'Devis' : 'Facture'}-${doc.number ?? 'brouillon'}-${client.name}`.replace(/[^\w\-À-ÿ]+/g, '-');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{fileName}</title>
  </head>
  <body>
    <div class="toolbar">
      <a href={backHref}>← {backLabel}</a>
      <button type="button" onclick="window.print()">Imprimer / Enregistrer en PDF</button>
    </div>

    <article class="sheet">
      {stamp && <div class="stamp">{stamp}</div>}
      <header class="head">
        <div class="from">
          <div class="brand">
            <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="11" fill="#3049e0"></rect><g transform="translate(5 5) scale(1.25)"><path d="M12 4 14.34 6.34 17.66 6.34 17.66 9.66 20 12 17.66 14.34 17.66 17.66 14.34 17.66 12 20 9.66 17.66 6.34 17.66 6.34 14.34 4 12 6.34 9.66 6.34 6.34 9.66 6.34Z" fill="none" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path><circle cx="12" cy="12" r="2" fill="#f0a93b"></circle></g></svg>
            <span>{s.brand}</span>
          </div>
          <p class="legal-name">{s.company_name}</p>
          <p>{s.address}</p>
          <p>{[s.phone, s.email].filter(Boolean).join(' · ')}</p>
        </div>
        <div class="meta">
          <h1>{title}</h1>
          <table>
            <tr><th>N°</th><td>{doc.number ?? '—'}</td></tr>
            <tr><th>Date</th><td>{fmtDate(doc.issue_date)}</td></tr>
            {doc.due_date && <tr><th>{isDevis ? 'Valable jusqu’au' : 'Échéance'}</th><td>{fmtDate(doc.due_date)}</td></tr>}
          </table>
        </div>
      </header>

      <section class="parties">
        <div class="client">
          <p class="lbl">{isDevis ? 'Client' : 'Facturé à'}</p>
          <p class="cname">{client.company || client.name}</p>
          {client.company && <p>À l’attention de {client.name}</p>}
          {client.address && <p>{client.address}</p>}
          {client.city && <p>{client.city}</p>}
          {client.ice && <p>ICE : {client.ice}</p>}
          {client.phone && <p>Tél. : {client.phone}</p>}
        </div>
        {doc.subject && <div class="subject"><p class="lbl">Objet</p><p>{doc.subject}</p></div>}
      </section>

      <table class="items">
        <thead>
          <tr><th>Désignation</th><th class="n">Qté</th><th class="n">P.U. HT</th><th class="n">TVA</th><th class="n">Total HT</th></tr>
        </thead>
        <tbody>
          {lines.map((l) => (
            <tr>
              <td class="desc">{l.description}</td>
              <td class="n">{l.qty}</td>
              <td class="n">{mad(l.unit_price, false)}</td>
              <td class="n">{l.vat_rate} %</td>
              <td class="n">{mad(lineTotal(l), false)}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <section class="sum">
        <div class="words">
          <p>
            Arrêté{isDevis ? ' le présent devis' : 'e la présente facture'} à la somme de :
            <strong>{amountInWords(t.ttc)} TTC.</strong>
          </p>
          {t.tva === 0 && s.vat_mention && <p class="small">{s.vat_mention}</p>}
        </div>
        <table class="totals">
          <tr><th>Total HT</th><td>{mad(t.ht)}</td></tr>
          {t.vat.filter((v) => v.rate > 0).map((v) => <tr><th>TVA {v.rate} % (base {mad(v.base, false)})</th><td>{mad(v.amount)}</td></tr>)}
          {t.vat.some((v) => v.rate === 0) && t.vat.length > 1 && <tr><th>Montant non soumis à TVA</th><td>{mad(t.vat.find((v) => v.rate === 0)!.base)}</td></tr>}
          <tr class="ttc"><th>Total TTC</th><td>{mad(t.ttc)}</td></tr>
          {!isDevis && doc.paid > 0 && <tr><th>Déjà réglé</th><td>{mad(doc.paid)}</td></tr>}
          {!isDevis && doc.paid > 0 && <tr class="ttc"><th>Reste à payer</th><td>{mad(Math.max(0, doc.total_ttc - doc.paid))}</td></tr>}
        </table>
      </section>

      <section class="terms">
        {doc.notes && <p class="notes">{doc.notes}</p>}
        {!isDevis && s.payment_terms && <p><strong>Conditions de paiement :</strong> {s.payment_terms}</p>}
        {isDevis && doc.due_date && <p>Devis valable jusqu’au {fmtDate(doc.due_date)}. Les frais administratifs sont susceptibles d’évoluer selon les tarifs en vigueur.</p>}
        {(s.bank || s.rib) && <p><strong>Coordonnées bancaires :</strong> {[s.bank, s.rib && `RIB ${s.rib}`].filter(Boolean).join(' · ')}</p>}
      </section>

      {
        isDevis && (
          <section class="sign">
            <div><p class="lbl">Bon pour accord</p><p class="small">Date, signature et cachet du client, précédés de la mention « Bon pour accord »</p></div>
            <div class="box" />
          </section>
        )
      }

      <footer class="foot">
        <p>{legal.join(' — ')}</p>
        {s.footer && <p>{s.footer}</p>}
      </footer>
    </article>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 14mm 14mm 16mm;
  }
  * {
    box-sizing: border-box;
    margin: 0;
  }
  body {
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    color: #0e1424;
    background: #e9e6e0;
    font-size: 10.5pt;
    line-height: 1.45;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .toolbar {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    background: #0b1433;
    z-index: 5;
  }
  .toolbar a {
    color: #c9d0ea;
    text-decoration: none;
  }
  .toolbar button {
    background: #3049e0;
    color: #fff;
    border: 0;
    border-radius: 99px;
    padding: 10px 18px;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .sheet {
    position: relative;
    width: 210mm;
    min-height: 297mm;
    margin: 24px auto;
    padding: 16mm 15mm 18mm;
    background: #fff;
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.12);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .stamp {
    position: absolute;
    top: 105mm;
    left: 50%;
    translate: -50% 0;
    rotate: -18deg;
    font: 700 54pt/1 'Bricolage Grotesque Variable', system-ui, sans-serif;
    letter-spacing: 0.08em;
    color: rgb(18 128 90 / 0.14);
    border: 6px solid rgb(18 128 90 / 0.14);
    padding: 8px 24px;
    border-radius: 16px;
    pointer-events: none;
  }
  .head {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 18px;
    border-bottom: 2px solid #0e1424;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 700 17pt/1 'Bricolage Grotesque Variable', system-ui, sans-serif;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }
  .from p {
    color: #2b3245;
    font-size: 9.5pt;
  }
  .from .legal-name {
    font-weight: 700;
    color: #0e1424;
    font-size: 10.5pt;
  }
  .meta {
    text-align: right;
  }
  .meta h1 {
    font: 700 26pt/1 'Bricolage Grotesque Variable', system-ui, sans-serif;
    letter-spacing: -0.02em;
    color: #3049e0;
    margin-bottom: 10px;
  }
  .meta table {
    margin-left: auto;
    border-collapse: collapse;
  }
  .meta th {
    text-align: right;
    font-weight: 500;
    color: #5b6275;
    padding: 2px 10px 2px 0;
  }
  .meta td {
    font-weight: 700;
    text-align: right;
  }
  .parties {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 20px;
    margin: 20px 0 18px;
  }
  .client {
    background: #f6f1e8;
    border-radius: 10px;
    padding: 12px 14px;
  }
  .lbl {
    font-size: 8pt;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #5b6275;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .cname {
    font-weight: 700;
    font-size: 11.5pt;
  }
  .subject {
    padding: 12px 0;
  }
  .items {
    width: 100%;
    border-collapse: collapse;
  }
  .items th {
    background: #0b1433;
    color: #fff;
    text-align: left;
    font-weight: 600;
    font-size: 9pt;
    padding: 8px 10px;
  }
  .items th:first-child {
    border-radius: 6px 0 0 6px;
  }
  .items th:last-child {
    border-radius: 0 6px 6px 0;
  }
  .items td {
    padding: 9px 10px;
    border-bottom: 1px solid #e6dfd2;
    vertical-align: top;
  }
  .items .n {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .items .desc {
    white-space: pre-line;
  }
  .sum {
    display: grid;
    grid-template-columns: 1fr 78mm;
    gap: 20px;
    margin-top: 16px;
    break-inside: avoid;
  }
  .words p {
    font-size: 9.5pt;
  }
  .words .small {
    margin-top: 6px;
    color: #5b6275;
  }
  .totals {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .totals th {
    text-align: left;
    font-weight: 500;
    color: #2b3245;
    padding: 4px 0;
  }
  .totals td {
    text-align: right;
    white-space: nowrap;
    padding: 4px 0;
  }
  .totals .ttc th,
  .totals .ttc td {
    border-top: 1.5px solid #0e1424;
    padding-top: 8px;
    font-weight: 700;
    font-size: 12pt;
    color: #0e1424;
  }
  .terms {
    margin-top: 20px;
    display: grid;
    gap: 6px;
    font-size: 9.5pt;
    color: #2b3245;
    break-inside: avoid;
  }
  .notes {
    white-space: pre-line;
  }
  .sign {
    margin-top: 22px;
    display: grid;
    grid-template-columns: 1fr 80mm;
    gap: 20px;
    break-inside: avoid;
  }
  .sign .small {
    font-size: 8.5pt;
    color: #5b6275;
  }
  .sign .box {
    height: 30mm;
    border: 1px dashed #b8ae9c;
    border-radius: 8px;
  }
  .foot {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid #e6dfd2;
    font-size: 8pt;
    color: #5b6275;
    text-align: center;
    display: grid;
    gap: 2px;
  }
  @media print {
    body {
      background: #fff;
    }
    .toolbar {
      display: none;
    }
    .sheet {
      width: auto;
      min-height: calc(297mm - 30mm);
      margin: 0;
      padding: 0;
      box-shadow: none;
    }
  }
  @media screen and (max-width: 820px) {
    .sheet {
      width: auto;
      min-height: 0;
      margin: 12px;
      padding: 20px;
    }
  }
</style>
