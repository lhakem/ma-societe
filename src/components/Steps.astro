---
interface Props {
  steps: { title: string; text: string; meta?: string }[];
}
const { steps } = Astro.props;
---

<ol class="steps">
  {
    steps.map((s, i) => (
      <li class="step">
        <span class="step-num" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <div>
          {s.meta && <span class="badge badge--saffron">{s.meta}</span>}
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 20px;
    counter-reset: step;
  }
  .step {
    position: relative;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 26px 24px;
  }
  .step-num {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.6rem;
    letter-spacing: -0.04em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--brand-500);
    margin-bottom: 18px;
  }
  .badge {
    margin-bottom: 10px;
  }
  h3 {
    font-size: 1.18rem;
  }
  p {
    margin-top: 8px;
    color: var(--ink-500);
    font-size: 0.97rem;
    line-height: 1.6;
  }
  :global(.section--night) .step {
    background: var(--night-2);
    border-color: rgb(255 255 255 / 0.08);
  }
  :global(.section--night) .step p {
    color: #aab3d4;
  }
  :global(.section--night) .step-num {
    -webkit-text-stroke-color: var(--saffron);
  }
</style>
