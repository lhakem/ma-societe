---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { mainNav } from '../config/nav';
import { site } from '../config/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand">
      <Logo />
    </a>

    <nav class="nav" id="main-nav" aria-label="Navigation principale">
      <ul class="nav-list">
        {
          mainNav.map((item, i) =>
            'children' in item ? (
              <li class="nav-item has-sub">
                <button
                  type="button"
                  class:list={['nav-link', { 'is-active': item.children.some((c) => isActive(c.href)) }]}
                  aria-expanded="false"
                  aria-controls={`subnav-${i}`}>
                  {item.label}
                  <Icon name="chevron" size={16} class="chev" />
                </button>
                <div class="subnav" id={`subnav-${i}`}>
                  <ul>
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} class="sub-link" aria-current={isActive(c.href) ? 'page' : undefined}>
                          <span class="icon-tile">
                            <Icon name={c.icon ?? 'info'} />
                          </span>
                          <span>
                            <strong>{c.label}</strong>
                            <small>{c.desc}</small>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li class="nav-item">
                <a
                  class:list={['nav-link', { 'is-active': isActive(item.href) }]}
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <div class="nav-mobile-cta">
        <a class="btn btn--primary btn--block" href="/tarifs/#simulateur">Calculer mon prix</a>
        <a class="btn btn--ghost btn--block" href={`tel:${site.phoneE164}`}>
          <Icon name="phone" />
          {site.phoneDisplay}
        </a>
      </div>
    </nav>

    <div class="header-actions">
      <a class="header-phone" href={`tel:${site.phoneE164}`}>
        <Icon name="phone" size={18} />
        <span>{site.phoneDisplay}</span>
      </a>
      <a class="btn btn--primary btn--sm header-cta" href="/tarifs/#simulateur">Créer ma société</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        <span class="sr-only">Menu</span>
        <Icon name="menu" class="i-open" />
        <Icon name="x" class="i-close" />
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
    const subBtns = [...header.querySelectorAll<HTMLButtonElement>('.has-sub > button')];
    const closeSubs = (except?: HTMLButtonElement) =>
      subBtns.forEach((b) => b !== except && b.setAttribute('aria-expanded', 'false'));
    const setMenu = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('nav-open', open);
    };

    toggle.addEventListener('click', () => setMenu(!header.hasAttribute('data-open')));
    subBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        closeSubs(btn);
        btn.setAttribute('aria-expanded', String(open));
      }),
    );
    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) closeSubs();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeSubs();
        setMenu(false);
      }
    });
    header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgb(252 250 246 / 0.86);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .site-header.is-scrolled {
    border-color: var(--line);
    box-shadow: 0 6px 20px -16px rgb(14 20 36 / 0.25);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--header-h);
  }
  .brand {
    text-decoration: none;
    flex: none;
  }
  .nav {
    flex: 1;
  }
  .nav-list {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 2px;
    justify-content: center;
  }
  .nav-item {
    position: relative;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 10px 14px;
    border-radius: 999px;
    border: 0;
    background: none;
    font-weight: 550;
    font-size: 0.97rem;
    color: var(--ink-700);
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .nav-link:hover,
  .nav-link[aria-expanded='true'] {
    background: var(--sand-200);
    color: var(--ink-900);
  }
  .nav-link.is-active {
    color: var(--brand-600);
  }
  .nav-link :global(.chev) {
    transition: transform 0.2s;
  }
  .nav-link[aria-expanded='true'] :global(.chev) {
    transform: rotate(180deg);
  }

  .subnav {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    translate: -50% 0;
    width: 340px;
    padding: 8px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.18s, transform 0.18s, visibility 0.18s;
  }
  .subnav::before {
    content: '';
    position: absolute;
    inset: -12px 0 auto;
    height: 12px;
  }
  .subnav ul {
    list-style: none;
    padding: 0;
  }
  .has-sub:hover .subnav,
  .nav-link[aria-expanded='true'] + .subnav {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .sub-link {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 10px 12px;
    border-radius: 14px;
    text-decoration: none;
    color: var(--ink-700);
  }
  .sub-link:hover,
  .sub-link[aria-current='page'] {
    background: var(--sand-100);
    color: var(--ink-900);
  }
  .sub-link .icon-tile {
    width: 40px;
    height: 40px;
    border-radius: 12px;
  }
  .sub-link .icon-tile :global(svg) {
    width: 20px;
    height: 20px;
  }
  .sub-link strong {
    display: block;
    font-weight: 600;
    color: var(--ink-900);
    font-size: 0.95rem;
  }
  .sub-link small {
    display: block;
    color: var(--ink-500);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: none;
  }
  .header-phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink-900);
    text-decoration: none;
  }
  .header-phone:hover {
    color: var(--brand-600);
  }
  .menu-toggle {
    display: none;
    width: 46px;
    height: 46px;
    place-items: center;
    border-radius: 14px;
    border: 1px solid var(--line-strong);
    background: var(--white);
    cursor: pointer;
  }
  .menu-toggle :global(.i-close) {
    display: none;
  }
  [data-open] .menu-toggle :global(.i-close) {
    display: block;
  }
  [data-open] .menu-toggle :global(.i-open) {
    display: none;
  }
  .nav-mobile-cta {
    display: none;
  }

  @media (max-width: 1180px) {
    .header-phone span {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    .menu-toggle {
      display: grid;
    }
    .header-phone {
      display: none;
    }
    .header-actions {
      margin-left: auto;
    }
    /* backdrop-filter crée un bloc conteneur pour les éléments fixed : on le retire quand le menu est ouvert */
    .site-header[data-open] {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: var(--sand-50);
      border-color: var(--line);
    }
    .nav {
      position: fixed;
      top: var(--header-h);
      left: 0;
      right: 0;
      height: calc(100dvh - var(--header-h));
      background: var(--sand-50);
      padding: 16px var(--gutter) 32px;
      overflow-y: auto;
      display: none;
      flex-direction: column;
      gap: 24px;
      border-top: 1px solid var(--line);
    }
    [data-open] .nav {
      display: flex;
    }
    .nav-list {
      flex-direction: column;
      gap: 4px;
    }
    .nav-link {
      width: 100%;
      justify-content: space-between;
      padding: 14px 12px;
      font-size: 1.1rem;
      border-radius: 14px;
    }
    .subnav {
      position: static;
      translate: none;
      width: auto;
      box-shadow: none;
      border: 0;
      background: transparent;
      padding: 0 0 8px;
      display: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .has-sub:hover .subnav {
      display: none;
    }
    .nav-link[aria-expanded='true'] + .subnav {
      display: block;
    }
    .nav-mobile-cta {
      display: grid;
      gap: 10px;
    }
  }
  @media (max-width: 420px) {
    .header-cta {
      display: none;
    }
  }
  :global(html.nav-open) {
    overflow: hidden;
  }
</style>
