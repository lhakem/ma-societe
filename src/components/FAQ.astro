---
/** Accordéon FAQ. Pensez à passer faq(items) dans le `schema` de la page pour les données structurées. */
interface Props {
  items: { q: string; a: string }[];
  openFirst?: boolean;
}
const { items, openFirst = true } = Astro.props;
---

<div class="faq">
  {
    items.map((it, i) => (
      <details class="faq-item" open={openFirst && i === 0}>
        <summary>
          <h3>{it.q}</h3>
          <span class="faq-icon" aria-hidden="true" />
        </summary>
        <div class="faq-a" set:html={it.a} />
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 12px;
  }
  .faq-item {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 18px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .faq-item[open] {
    border-color: var(--brand-200);
    box-shadow: var(--shadow);
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 24px;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h3 {
    font-family: var(--font-body);
    font-size: 1.04rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }
  .faq-icon {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--sand-100);
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink-900);
    translate: -50% -50%;
    transition: rotate 0.2s;
  }
  .faq-icon::after {
    rotate: 90deg;
  }
  [open] .faq-icon {
    background: var(--brand-500);
  }
  [open] .faq-icon::before,
  [open] .faq-icon::after {
    background: #fff;
  }
  [open] .faq-icon::after {
    rotate: 0deg;
  }
  .faq-a {
    padding: 0 24px 22px;
    color: var(--ink-500);
    line-height: 1.7;
  }
  .faq-a :global(a) {
    font-weight: 500;
  }
</style>
